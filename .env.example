# Copia este archivo como .env y pon tus datos
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inwork_pagos

# Debe ser EXACTAMENTE la misma SECRET_KEY del .env de la API principal (FastAPI).
# Con ella esta API comprueba que el token del usuario es real.
SECRET_KEY=la_misma_clave_de_la_api_principal
